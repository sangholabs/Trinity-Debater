# ==============================================================================
# Trinity-Debater Config Template
# ==============================================================================

# Discord Bot Token
# Get one from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Note: API Keys for Claude and Codex are NOT needed in this file.
# Trinity-Debater relies on your local CLI authentication sessions.
# Make sure to run `claude login` and `codex login` (or set their respective environment variables natively) before starting the bot.
